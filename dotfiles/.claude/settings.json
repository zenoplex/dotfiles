{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git push *HEAD*)",
      "Bash(git push *@*)",
      "Bash(git push *+*)",
      "Bash(git push *:**)",
      "Bash(git push *refs/*)",
      "Bash(git push *--*)",
      "Bash(git push * -*)",
      "Bash(git push *'*)",
      "Bash(git push *\"*)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude/hooks/herdr-agent-state.sh ] && bash ~/.claude/hooks/herdr-agent-state.sh session || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx ccusage statusline"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "playground@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "understand-anything@understand-anything": true,
    "cloudflare@cloudflare": true,
    "superpowers@claude-plugins-official": true,
    "retro@netresearch-claude-code-marketplace": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "logo-design@logo-design-skill": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "netresearch-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "netresearch/claude-code-marketplace"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "logo-design-skill": {
      "source": {
        "source": "github",
        "repo": "kaankiziltug/logo-design-skill"
      }
    }
  },
  "outputStyle": "Concise",
  "advisorModel": "fable",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
