{
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git push *HEAD*)",
      "Bash(git push *+*)",
      "Bash(git push * :*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--prune*)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx ccusage statusline"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "playground@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "understand-anything@understand-anything": true,
    "cloudflare@cloudflare": true,
    "superpowers@claude-plugins-official": true,
    "retro@netresearch-claude-code-marketplace": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "logo-design@logo-design-skill": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "compound-engineering-plugin": {
      "source": {
        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "netresearch-claude-code-marketplace": {
      "source": {
        "source": "github",
        "repo": "netresearch/claude-code-marketplace"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "logo-design-skill": {
      "source": {
        "source": "github",
        "repo": "kaankiziltug/logo-design-skill"
      }
    }
  },
  "outputStyle": "Concise",
  "advisorModel": "fable",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
