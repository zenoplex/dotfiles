[user]
	name = Gen Ichino
	email = zenoplex@gmail.com
	username = zenoplex
[color]
	ui = auto
[alias]
	co = checkout
	s = status -s
	br = branch
	brdm = !git branch --merged | egrep -v '(^\\*|master|main)' | xargs git branch -d
[ghq]
	root = ~/projects/
[init]
	defaultBranch = main
[diff]
	tool = vscode
[merge]
	tool = vscode
[rebase]
	autosquash = true
[commit]
	template = ~/.config/git/message
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[include]
	path = ~/.config/git/config.local
